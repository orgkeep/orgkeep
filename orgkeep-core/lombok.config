config.stopBubbling = true

# Lets @RequiredArgsConstructor copy @io.quarkus.cache.CacheName onto the generated constructor parameter, so a
# programmatic Cache can be constructor-injected (private final) like every other dependency instead of needing a
# separate @Inject field (see repository/keycloak/KeycloakClients, KeycloakGroups, components/catalog/CatalogSetup).
lombok.copyableAnnotations += io.quarkus.cache.CacheName
