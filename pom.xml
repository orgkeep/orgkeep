<?xml version="1.0" encoding="UTF-8"?>
<!--
The parent of the modules of Orgkeep, and the aggregator that builds them together (the reactor orders them by their
dependencies: the core before the dashboard). One version for all: they are released together, with one tag.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.orgkeep</groupId>
    <artifactId>orgkeep-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Orgkeep</name>
    <description>Multi-tenant B2B on top of Keycloak</description>
    <url>https://orgkeep.org</url>

    <modules>
        <module>orgkeep-core</module>
        <module>orgkeep-dashboard</module>
        <module>orgkeep-theme</module>
    </modules>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <!-- where the maven-release-plugin commits, tags and pushes. The modules inherit it as it is: without the
         attributes, Maven would append their artifactId to each URL. -->
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/orgkeep/orgkeep.git</connection>
        <developerConnection>scm:git:git@github.com:orgkeep/orgkeep.git</developerConnection>
        <url>https://github.com/orgkeep/orgkeep</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <quarkus.platform.version>3.40.1</quarkus.platform.version>
        <!-- 1.18.40+ is required to compile on JDK 25 -->
        <lombok.version>1.18.42</lombok.version>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.4</surefire-plugin.version>
        <jacoco-plugin.version>0.8.15</jacoco-plugin.version>

        <!-- The single source of truth for the Keycloak version: Dev Services (dev and test, overriding the
             default of the Quarkus platform) and the ghcr.io/orgkeep/orgkeep-keycloak image (orgkeep-theme/Dockerfile)
             both run on it, so the tests run on the version that ships.
             Not 26.8.2 (the latest at the time of writing): on that version, the Admin REST API refuses every
             client-credentials token of a realm client, including orgkeep-admin itself (reproduced directly against
             plain Keycloak, so this is a Keycloak-side regression, not an Orgkeep one); OnPremiseBootstrap then
             refuses to start. Revisit once Keycloak fixes it.
             Tracked by hand, no Dependabot or Renovate: bumping it needs the compatibility check above, which they
             cannot do.
             A test run from an IDE (not through mvn) does not see this property (it only reaches Dev Services via
             the systemPropertyVariables of surefire/failsafe, or quarkus:dev's own configuration below) and falls
             back to the default Keycloak version of the Quarkus platform instead. -->
        <keycloak.version>26.8.1</keycloak.version>

        <!-- SonarQube Cloud: one project per module (sonar.projectKey set in each module's pom), analysed by the
             CI with `mvn -pl <module> sonar:sonar` (never bound to a build phase, see pluginManagement below). -->
        <sonar.organization>orgkeep</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- the dashboard embeds the core of the same version -->
            <dependency>
                <groupId>org.orgkeep</groupId>
                <artifactId>orgkeep-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- each Quarkus module declares it again, with <extensions>true</extensions> -->
                <plugin>
                    <groupId>io.quarkus.platform</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build</goal>
                                <goal>generate-code</goal>
                                <goal>generate-code-tests</goal>
                            </goals>
                        </execution>
                    </executions>
                    <!-- quarkus:dev (mvn quarkus:dev) runs its own forked JVM, not the one of surefire/failsafe below:
                         pin the Keycloak Dev Services image there too, so dev and test run the same version. -->
                    <configuration>
                        <systemProperties>
                            <quarkus.keycloak.devservices.image-name>quay.io/keycloak/keycloak:${keycloak.version}</quarkus.keycloak.devservices.image-name>
                        </systemProperties>
                    </configuration>
                </plugin>
                <!-- the annotation processors are declared by each module: the core has MapStruct, the dashboard not -->
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                            <maven.home>${maven.home}</maven.home>
                            <!-- overrides the default.image of quarkus-devservices-keycloak, so the tests run on the
                                 Keycloak version we ship (keycloak.version above) -->
                            <quarkus.keycloak.devservices.image-name>quay.io/keycloak/keycloak:${keycloak.version}</quarkus.keycloak.devservices.image-name>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <quarkus.keycloak.devservices.image-name>quay.io/keycloak/keycloak:${keycloak.version}</quarkus.keycloak.devservices.image-name>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <!-- invoked explicitly from the CI (mvn -pl <module> sonar:sonar), never during a normal build:
                     no execution bound to it here. -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>5.9.0.7382</version>
                </plugin>
                <!-- The JaCoCo Java agent (prepare-agent): a -javaagent that instruments classes as they load, the
                     only way to get coverage of the plain JUnit test classes that do not boot Quarkus (mapper
                     tests, KeycloakErrorsTest...). quarkus-jacoco, by contrast, instruments the application's own
                     classes at build time, for the @QuarkusTest runs. prepare-agent sets the "argLine" property
                     read by maven-surefire-plugin (late evaluation, @{argLine}, see its configuration in each
                     module) before the forked test JVM starts. destFile matches quarkus-jacoco's own default data
                     file (target/jacoco-quarkus.exec): both agents then write to (and, with JaCoCo's default
                     append=true, accumulate into) the same file, so the final report reflects both kinds of tests.
                     See quarkus.jacoco.reuse-data-file in each module's application.properties. -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                            <configuration>
                                <destFile>${project.build.directory}/jacoco-quarkus.exec</destFile>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- mvn release:prepare, from this directory: one version for every module, tag v<version> (which starts
                 the Release workflow on GitHub), next SNAPSHOT, then push. No release:perform: nothing is deployed
                 to a Maven repository. -->
            <plugin>
                <artifactId>maven-release-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <autoVersionSubmodules>true</autoVersionSubmodules>
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <signTag>true</signTag>
                    <scmReleaseCommitComment>Release @{releaseLabel}</scmReleaseCommitComment>
                    <scmDevelopmentCommitComment>Next development version</scmDevelopmentCommitComment>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
