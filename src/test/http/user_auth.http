### Token of the realm owner of the dev realm (demo, created by OnPremiseBootstrap)
# Login client of the realm (clientId = realm name): DemoSeeder enables the password grant on it for the demo.
POST {{keycloak_url}}/realms/demo/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=demo
    &username=realm-owner
    &password=password
    &grant_type=password

> {%
    client.global.set("auth_token", response.body.access_token);
%}
